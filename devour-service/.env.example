# ===== 应用 =====
APP_NAME=devour-service
APP_ENV=local
# 逗号分隔的允许跨域来源（前端 dev server）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# 日志目录与级别（业务日志 app.log、提示词 prompt.log、响应 response.log 都在此目录）
LOG_DIR=logs
LOG_LEVEL=INFO

# ===== 大模型 =====
# 默认 provider / 模型（请求体可动态覆盖）
LLM_DEFAULT_PROVIDER=dashscope
LLM_DEFAULT_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
# LLM 调用代理：留空=直连（默认忽略系统 *_PROXY，适合国内 dashscope 等端点）；
# 若需走代理访问 openai/gemini 等，填 http://127.0.0.1:7897 或 socks5://127.0.0.1:7897
LLM_PROXY=

# 各 provider 的 API Key（按需填写；默认走 dashscope 只需填 DASHSCOPE_API_KEY）
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
GEMINI_API_KEY=

# 可选：覆盖某 provider 的 base_url（留空用内置默认）
# DASHSCOPE_BASE_URL=

# ===== 本地 SQLite 数据库 =====
DB_PATH=./data/devour.db

# ===== Skills 根目录（相对 devour-service/）=====
SKILLS_DIR=../skills
